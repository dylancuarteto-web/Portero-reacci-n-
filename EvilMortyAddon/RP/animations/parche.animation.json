{
  "format_version": "1.8.0",
  "animations": {
    "animation.evilmorty.parche.idle": {
      "loop": true,
      "animation_length": 2.0,
      "bones": {
        "anillo": {
          "rotation": [
            0,
            0,
            "query.anim_time * 90"
          ]
        },
        "lente": {
          "scale": [
            "1.0 + math.sin(query.anim_time * 360) * 0.12",
            "1.0 + math.sin(query.anim_time * 360) * 0.12",
            "1.0"
          ]
        },
        "led": {
          "scale": "math.mod(query.anim_time, 1.0) < 0.5 ? 1.0 : 0.2"
        },
        "antena_punta": {
          "scale": "math.mod(query.anim_time + 0.5, 1.0) < 0.3 ? 1.3 : 0.8"
        }
      }
    }
  }
}
