{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "evilmorty:laser_estela",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/evilmorty"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.min(variable.longitud * 2.5, 100)"
      },
      "minecraft:emitter_shape_custom": {
        "offset": [
          "variable.dir_x * variable.longitud * variable.particle_random_1",
          "variable.dir_y * variable.longitud * variable.particle_random_1",
          "variable.dir_z * variable.longitud * variable.particle_random_1"
        ],
        "direction": [
          "variable.particle_random_2 - 0.5",
          "variable.particle_random_3 - 0.5",
          "variable.particle_random_4 - 0.5"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.18 + variable.particle_random_2 * 0.25"
      },
      "minecraft:particle_initial_speed": 0.4,
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 3
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.16 + (0.02 - 0.16) * variable.particle_age / variable.particle_lifetime)",
          "(0.16 + (0.02 - 0.16) * variable.particle_age / variable.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.0": "#FFFFE6AA",
            "0.5": "#FFFF7828",
            "1.0": "#00C8280A"
          },
          "interpolant": "variable.particle_age / variable.particle_lifetime"
        }
      }
    }
  }
}
