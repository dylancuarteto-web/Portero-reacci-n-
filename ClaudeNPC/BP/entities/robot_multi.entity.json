        "max": 60
      },
      "minecraft:physics": {
        "has_gravity": false,
        "has_collision": true
      },
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": false
      },
      "minecraft:knockback_resistance": {
        "value": 1.0
      },
      "minecraft:nameable": {
        "always_show": true,
        "allow_name_tag_renaming": false
      },
      "minecraft:persistent": {},
      "minecraft:fire_immune": true,
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "on_damage": {
              "filters": {
                "test": "has_tag",
                "subject": "self",
                "value": "claudenpc_intocable"
              }
            },
            "deals_damage": "no"
          },
          {
            "on_damage": {
              "filters": {
                "any_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "claudenpc"
                  },
                  {
                    "test": "is_family",
                    "subject": "damager",
                    "value": "claudenpc"
                  }
                ]
              }
            },
            "deals_damage": "no"
          },
          {
            "cause": "fall",
            "deals_damage": "no"
          },
          {
            "cause": "suffocation",
            "deals_damage": "no"
          },
          {
            "on_damage": {
              "filters": {
                "test": "has_damage",
                "value": "fatal"
              },
              "event": "claudenpc:golpe_fatal",
              "target": "self"
            },
            "deals_damage": "no"
          }
        ]
      },
      "minecraft:movement": {
        "value": 0.0
      },
      "minecraft:behavior.look_at_player": {
        "priority": 9,
        "look_distance": 8
