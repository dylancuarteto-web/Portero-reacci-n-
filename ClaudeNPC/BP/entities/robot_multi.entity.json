{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "claudenpc:robot_multi",
      "is_spawnable": false,
      "is_summonable": true,
      "properties": {
        "claudenpc:volando": {
          "type": "bool",
          "default": false,
          "client_sync": true
        },
        "claudenpc:apagado": {
          "type": "bool",
          "default": false,
          "client_sync": true
        },
        "claudenpc:cargando": {
          "type": "bool",
          "default": false,
          "client_sync": true
        }
      }
    },
    "components": {
