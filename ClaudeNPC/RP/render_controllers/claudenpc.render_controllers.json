{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.claudenpc": {
      "geometry": "Geometry.default",
      "textures": [
        "Texture.default"
      ],
      "materials": [
        {
          "*": "Material.default"
        },
        {
          "emblema": "Material.glow"
        }
      ],
      "part_visibility": [
        {
          "*": true
        },
        {
          "herr_martillo": false
        },
        {
          "herr_destornillador": false
        },
        {
          "herr_llave": false
        }
      ]
    },
    "controller.render.claudenpc_npc": {
      "geometry": "Geometry.default",
      "textures": [
        "Texture.default"
      ],
      "materials": [
        {
          "*": "Material.default"
        },
        {
          "emblema": "Material.glow"
        }
      ],
      "part_visibility": [
        {
          "*": true
        },
        {
          "herr_martillo": "query.property('claudenpc:herramienta') == 1"
        },
        {
          "herr_destornillador": "query.property('claudenpc:herramienta') == 2"
        },
        {
          "herr_llave": "query.property('claudenpc:herramienta') == 3"
        }
      ]
    },
    "controller.render.claudenpc_golden": {
      "geometry": "Geometry.default",
      "textures": [
        "Texture.default"
      ],
      "materials": [
        {
          "*": "Material.default"
        },
        {
          "aura_head": "Material.aura"
        },
        {
          "aura_body": "Material.aura"
        },
        {
          "aura_rarm": "Material.aura"
        },
        {
          "aura_larm": "Material.aura"
        },
        {
          "aura_rleg": "Material.aura"
        },
        {
          "aura_lleg": "Material.aura"
        }
      ]
    },
    "controller.render.claudenpc_robot": {
      "arrays": {
        "textures": {
          "Array.fases": [
            "Texture.default",
            "Texture.turbo",
            "Texture.genio"
          ]
        }
      },
      "geometry": "Geometry.default",
      "textures": [
        "Array.fases[query.property('claudenpc:fase')]"
      ],
      "materials": [
        {
          "*": "Material.default"
        },
        {
          "cupula": "Material.cristal"
        }
      ],
      "part_visibility": [
        {
          "*": true
        },
        {
          "antebrazo_izq": "!query.property('claudenpc:sin_puno')"
        },
        {
          "laser_izq": "!query.property('claudenpc:sin_puno')"
        }
      ]
    },
    "controller.render.claudenpc_aura": {
      "geometry": "Geometry.default",
      "textures": [
        "Texture.default"
      ],
      "materials": [
        {
          "*": "Material.default"
        },
        {
          "brillo*": "Material.brillo"
        }
      ]
    },
    "controller.render.claudenpc_maestro": {
      "arrays": {
        "textures": {
          "Array.pieles": [
            "Texture.default",
            "Texture.einstein",
            "Texture.tesla",
            "Texture.curie",
            "Texture.newton",
            "Texture.lovelace"
          ]
        }
      },
      "geometry": "Geometry.default",
      "textures": [
        "Array.pieles[query.property('claudenpc:variante')]"
      ],
      "materials": [
        {
          "*": "Material.default"
        },
        {
          "pin": "Material.glow"
        },
        {
          "vidrio": "Material.vidrio"
        }
      ],
      "part_visibility": [
        {
          "*": true
        },
        {
          "lentes": "query.property('claudenpc:variante') == 0"
        },
        {
          "vidrio": "query.property('claudenpc:variante') == 0"
        },
        {
          "corbata": "query.property('claudenpc:variante') == 0 || query.property('claudenpc:variante') == 2 || query.property('claudenpc:variante') == 4"
        },
        {
          "bigote": "query.property('claudenpc:variante') == 1 || query.property('claudenpc:variante') == 2"
        },
        {
          "pelo_alborotado": "query.property('claudenpc:variante') == 1"
        },
        {
          "mono": "query.property('claudenpc:variante') == 3"
        },
        {
          "peluca": "query.property('claudenpc:variante') == 4"
        },
        {
          "rizos": "query.property('claudenpc:variante') == 5"
        },
        {
          "falda": "query.property('claudenpc:variante') == 3 || query.property('claudenpc:variante') == 5"
        }
      ]
    }
  }
}
