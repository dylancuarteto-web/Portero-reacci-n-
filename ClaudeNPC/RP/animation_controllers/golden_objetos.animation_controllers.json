{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.claudenpc.corazon.brillo": {
      "initial_state": "brilla",
      "states": {
        "brilla": {
          "particle_effects": [
            {
              "effect": "brillo",
              "locator": "centro"
            },
            {
              "effect": "rayos",
              "locator": "centro"
            }
          ]
        }
      }
    },
    "controller.animation.claudenpc.orbe.amarilla": {
      "initial_state": "vuela",
      "states": {
        "vuela": {
          "particle_effects": [
            {
              "effect": "estela_am",
              "locator": "centro"
            }
          ]
        }
      }
    },
    "controller.animation.claudenpc.orbe.azul": {
      "initial_state": "vuela",
      "states": {
        "vuela": {
          "particle_effects": [
            {
              "effect": "estela_az",
              "locator": "centro"
            }
          ]
        }
      }
    },
    "controller.animation.claudenpc.orbe.definitiva": {
      "initial_state": "vuela",
      "states": {
        "vuela": {
          "particle_effects": [
            {
              "effect": "sonico",
              "locator": "centro"
            },
            {
              "effect": "chispas",
              "locator": "centro"
            },
            {
              "effect": "estela_am",
              "locator": "centro"
            }
          ]
        }
      }
    },
    "controller.animation.claudenpc.reloj.estado": {
      "initial_state": "tic",
      "states": {
        "tic": {
          "animations": [
            "tic"
          ],
          "transitions": [
            {
              "alarma": "query.mark_variant == 1"
            },
            {
              "apagado": "query.mark_variant == 2"
            }
          ],
          "blend_transition": 0.2
        },
        "alarma": {
          "animations": [
            "tic",
            "alarma"
          ],
          "transitions": [
            {
              "tic": "query.mark_variant == 0"
            },
            {
              "apagado": "query.mark_variant == 2"
            }
          ],
          "blend_transition": 0.2
        },
        "apagado": {
          "animations": [
            "apagado"
          ],
          "particle_effects": [
            {
              "effect": "humo",
              "locator": "arriba"
            }
          ],
          "transitions": [
            {
              "tic": "query.mark_variant == 0"
            }
          ],
          "blend_transition": 0.4
        }
      }
    }
  }
}
