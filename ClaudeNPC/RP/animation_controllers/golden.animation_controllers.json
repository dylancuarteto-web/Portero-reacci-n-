{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.claudenpc.golden.ojo": {
      "initial_state": "brillar",
      "states": {
        "brillar": {
          "particle_effects": [
            {
              "effect": "ojo",
              "locator": "ojo_derecho"
            },
            {
              "effect": "halo_ojo",
              "locator": "ojo_derecho"
            }
          ],
          "transitions": [
            {
              "apagado": "query.skin_id == 1"
            }
          ]
        },
        "apagado": {
          "transitions": [
            {
              "brillar": "!(query.skin_id == 1)"
            }
          ]
        }
      }
    },
    "controller.animation.claudenpc.golden.orbes_mano": {
      "initial_state": "no",
      "states": {
        "no": {
          "transitions": [
            {
              "si": "query.skin_id == 2"
            }
          ]
        },
        "si": {
          "particle_effects": [
            {
              "effect": "mano_am",
              "locator": "mano_der"
            },
            {
              "effect": "mano_az",
              "locator": "mano_izq"
            }
          ],
          "transitions": [
            {
              "no": "!(query.skin_id == 2)"
            }
          ]
        }
      }
    }
  }
}
