    "controller.animation.claudenpc.golden.espadas": {
      "initial_state": "sin",
      "states": {
        "sin": {
          "transitions": [
            {
              "listo": "query.property('claudenpc:espadas')"
            }
          ]
        },
        "listo": {
          "animations": [
            "espada_listo"
          ],
          "transitions": [
            {
              "sin": "!query.property('claudenpc:espadas')"
            },
            {
              "corte_der": "query.property('claudenpc:corte') != v.corte_visto && math.mod(query.property('claudenpc:corte'), 3) == 1"
            },
            {
              "corte_izq": "query.property('claudenpc:corte') != v.corte_visto && math.mod(query.property('claudenpc:corte'), 3) == 2"
            },
            {
              "corte_x": "query.property('claudenpc:corte') != v.corte_visto && math.mod(query.property('claudenpc:corte'), 3) == 0"
            }
          ],
          "blend_transition": 0.08
        },
        "corte_der": {
          "animations": [
            "corte_der"
          ],
          "on_entry": [
            "v.corte_visto = query.property('claudenpc:corte');"
          ],
          "transitions": [
            {
              "listo": "query.all_animations_finished"
            }
          ],
          "blend_transition": 0.1
        },
        "corte_izq": {
          "animations": [
            "corte_izq"
          ],
          "on_entry": [
            "v.corte_visto = query.property('claudenpc:corte');"
          ],
          "transitions": [
            {
              "listo": "query.all_animations_finished"
            }
          ],
          "blend_transition": 0.1
        },
        "corte_x": {
          "animations": [
            "corte_x"
          ],
          "on_entry": [
            "v.corte_visto = query.property('claudenpc:corte');"
          ],
          "transitions": [
            {
              "listo": "query.all_animations_finished"
            }
          ],
          "blend_transition": 0.1
        }
      }
    },
