          "particle_effects": [
            {
              "effect": "ojo",
              "locator": "ojo_derecho"
            },
            {
              "effect": "halo_ojo",
              "locator": "ojo_derecho"
            }
          ],
          "transitions": [
            {
              "apagado": "query.property('claudenpc:pose') == 1 || query.property('claudenpc:pose') == 2"
            }
          ]
        },
        "apagado": {
          "transitions": [
            {
              "brillar": "!(query.property('claudenpc:pose') == 1 || query.property('claudenpc:pose') == 2)"
            }
          ]
        }
