{
  "namespace": "hud",
  "boss_name_panel": {
    "bindings": [
      {
        "binding_name": "#bossName",
        "binding_type": "collection",
        "binding_collection_name": "boss_bars",
        "binding_condition": "always"
      },
      {
        "binding_type": "view",
        "source_property_name": "(((#bossName - 'olden') = #bossName) or ((#bossName - 'laude') = #bossName))",
        "target_property_name": "#visible",
        "binding_condition": "always"
      }
    ]
  },
  "boss_health_panel/progress_bar_for_collections": {
    "bindings": [
      {
        "binding_name": "#bossName",
        "binding_type": "collection",
        "binding_collection_name": "boss_bars",
        "binding_condition": "always"
      },
      {
        "binding_type": "view",
        "source_property_name": "(((#bossName - 'olden') = #bossName) or ((#bossName - 'laude') = #bossName))",
        "target_property_name": "#visible",
        "binding_condition": "always"
      }
    ]
  },
  "boss_health_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "claudenpc_barra_golden@claudenpc_jefe.barra_golden": {}
          }
        ]
      }
    ]
  }
}
