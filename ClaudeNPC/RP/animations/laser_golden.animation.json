{
  "format_version": "1.8.0",
  "animations": {
    "animation.claudenpc.laser.forma": {
      "loop": true,
      "bones": {
        "inclina": {
          "rotation": [
            "(query.variant - 45) * 2",
            0,
            0
          ]
        },
        "largo": {
          "scale": [
            1,
            1,
            "math.max(query.mark_variant, 1) * 0.5 * math.min(1, query.life_time * 16)"
          ]
        },
        "ancho": {
          "scale": [
            "(math.floor(query.skin_id / 4) == 0 ? 0.55 : (math.floor(query.skin_id / 4) == 1 ? 1.0 : (math.floor(query.skin_id / 4) == 2 ? 1.8 : 3.2)))",
            "(math.floor(query.skin_id / 4) == 0 ? 0.55 : (math.floor(query.skin_id / 4) == 1 ? 1.0 : (math.floor(query.skin_id / 4) == 2 ? 1.8 : 3.2)))",
            1
          ]
        },
        "pulso": {
          "scale": [
            "query.life_time < 0.05 ? 0.25 + query.life_time * 31 : (query.life_time < 0.2 ? 1.8 - (query.life_time - 0.05) * 5.333 : 1.0 + math.sin(query.life_time * 1600) * 0.06)",
            "query.life_time < 0.05 ? 0.25 + query.life_time * 31 : (query.life_time < 0.2 ? 1.8 - (query.life_time - 0.05) * 5.333 : 1.0 + math.sin(query.life_time * 1600) * 0.06)",
            1
          ]
        }
      }
    },
    "animation.claudenpc.laser.apagar": {
      "animation_length": 0.3,
      "loop": "hold_on_last_frame",
      "bones": {
        "fin": {
          "scale": {
            "0.0": [
              1,
              1,
              1
            ],
            "0.06": [
              1.35,
              1.35,
              1
            ],
            "0.3": [
              0,
              0,
              1
            ]
          }
        }
      }
    }
  }
}
