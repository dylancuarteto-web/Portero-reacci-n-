      "geometry": {
        "aspecto_0": "geometry.skeleton.v1.8",
        "aspecto_1": "geometry.skeleton.stray.v1.8",
        "aspecto_2": "geometry.skeleton.bogged",
        "ropa_0": "geometry.stray.armor.v1.8",
        "ropa_1": "geometry.bogged.armor",
        "ojos": "geometry.claudenpc.ojos_humanoide"
