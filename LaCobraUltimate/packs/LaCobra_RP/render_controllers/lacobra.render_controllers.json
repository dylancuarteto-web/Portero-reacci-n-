{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.lacobra.default": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ]
    },
    "controller.render.lacobra.boss": {
      "arrays": {
        "textures": {
          "Array.fases": [
            "Texture.f1",
            "Texture.f2",
            "Texture.f3"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.fases[math.clamp(query.property('lacobra:fase') - 1, 0, 2)]"
      ]
    },
    "controller.render.lacobra.serpiente": {
      "arrays": {
        "textures": {
          "Array.variantes": [
            "Texture.veneno",
            "Texture.guardiana"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.variantes[math.clamp(query.property('lacobra:variante'), 0, 1)]"
      ]
    }
  }
}