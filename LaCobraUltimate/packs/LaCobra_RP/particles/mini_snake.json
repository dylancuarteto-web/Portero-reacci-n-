{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "lacobra:mini_snake",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/lacobra_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 40,
        "max_particles": 14
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.3
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.7
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.cos(v.emitter_random_1 * 360) * 0.7 + math.sin(v.particle_age * 720) * 0.22",
          "v.particle_age * 3",
          "math.sin(v.emitter_random_1 * 360) * 0.7 + math.cos(v.particle_age * 720) * 0.22"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.11 * (1 - v.particle_age / v.particle_lifetime) + 0.03",
          "0.11 * (1 - v.particle_age / v.particle_lifetime) + 0.03"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            64,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.00": "#FFD2A8FF",
            "0.50": "#FFFFC233",
            "1.00": "#FFB3700F"
          }
        }
      }
    }
  }
}