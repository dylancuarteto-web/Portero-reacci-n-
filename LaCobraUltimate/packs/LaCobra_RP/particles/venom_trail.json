{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "lacobra:venom_trail",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/lacobra_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 25,
        "max_particles": 50
      },
      "minecraft:emitter_lifetime_looping": {
