{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "lacobra:aura_spiral",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/lacobra_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 14
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.8
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.cos(v.particle_age * 400 + v.particle_random_1 * 360) * (0.75 - v.particle_age * 0.3)",
          "v.particle_age * 2.4 + v.particle_random_2 * 0.2",
          "math.sin(v.particle_age * 400 + v.particle_random_1 * 360) * (0.75 - v.particle_age * 0.3)"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          0.09,
          0.09
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            32,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.particle_random_3 > 0.45 ? 1.0 : 0.1",
          "v.particle_random_3 > 0.45 ? 0.78 : 0.06",
          "v.particle_random_3 > 0.45 ? 0.2 : 0.14",
          "1 - v.particle_age / v.particle_lifetime"
        ]
      }
    }
  }
}