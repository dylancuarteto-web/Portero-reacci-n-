{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "estr:portal_spiral",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 40,
        "max_particles": 30
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.6
      },
      "minecraft:emitter_shape_custom": {
        "offset": [
          "-variable.dir_z * math.cos(variable.emitter_age * 900) * (1.1 - variable.emitter_age * 1.2)",
          "math.sin(variable.emitter_age * 900) * (1.1 - variable.emitter_age * 1.2)",
          "(variable.dir_x + ((variable.dir_x == 0 && variable.dir_z == 0) ? 1 : 0)) * math.cos(variable.emitter_age * 900) * (1.1 - variable.emitter_age * 1.2)"
        ],
        "direction": [
          "variable.dir_x",
          "0",
          "variable.dir_z"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.7
      },
      "minecraft:particle_initial_speed": 0.4,
      "minecraft:particle_motion_dynamic": {},
      "minecraft:particle_appearance_billboard": {
        "size": [
          0.2,
          0.2
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "flipbook": {
            "base_UV": [
              56,
              0
            ],
            "size_UV": [
              8,
              8
            ],
            "step_UV": [
              -8,
              0
            ],
            "frames_per_second": 8,
            "max_frame": 8,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.0": "#FFD8FF7A",
            "1.0": "#004CC23A"
          },
          "interpolant": "variable.particle_age / variable.particle_lifetime"
        }
      }
    }
  }
}
